generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id          String   @id @default(cuid())
  businessName String?
  senderName  String?
  senderEmail String?
  services    String?
  proof       String?
  tone        String?
  defaultCTA  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Campaign {
  id               String         @id @default(cuid())
  name             String
  serviceToPitch   String
  targetNiche      String
  targetLocation   String
  offer            String
  cta              String
  dailySendLimit   Int            @default(20)
  minimumFitScore  Int            @default(60)
  status           String         @default("DRAFT")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  leads            Lead[]
  emailSendLogs    EmailSendLog[]
  leadActivities   LeadActivity[]
}

model Lead {
  id                  String          @id @default(cuid())
  campaignId          String
  campaign            Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  companyName         String
  website             String?
  email               String?
  sourceUrl           String?
  industry            String?
  painPoint           String?
  offerAngle          String?
  personalizationLine String?
  fitScore            Int             @default(0)
  scoreBreakdown      String?
  status              String          @default("NEW")
  pipelineStatus      String          @default("NOT_CONTACTED")
  lastContactedAt     DateTime?
  repliedAt           DateTime?
  nextFollowUpAt      DateTime?
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  aiProviderUsed      String?
  aiModelUsed         String?
  discoverySource     String?
  extractionConfidence Int?
  extractionNotes     String?
  emailDrafts         EmailDraft[]
  emailSendLogs       EmailSendLog[]
  activities          LeadActivity[]
}

model EmailDraft {
  id              String         @id @default(cuid())
  leadId          String
  lead            Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subject         String
  body            String
  status          String         @default("DRAFT")
  type            String         @default("INITIAL")
  followUpNumber  Int            @default(0)
  sentAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  aiProviderUsed  String?
  aiModelUsed     String?
  sendLogs        EmailSendLog[]
}

model EmailSendLog {
  id             String    @id @default(cuid())
  emailDraftId   String
  emailDraft     EmailDraft @relation(fields: [emailDraftId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  recipientEmail String
  subject        String
  status         String    @default("SENT")
  reason         String?
  simulated      Boolean   @default(true)
  realSend       Boolean   @default(false)
  provider       String?
  messageId      String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
}

model LeadActivity {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type       String
  message    String
  createdAt  DateTime @default(now())
}

model Unsubscribe {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model UnsubscribeToken {
  id         String   @id @default(cuid())
  email      String
  token      String   @unique
  campaignId String?
  leadId     String?
  createdAt  DateTime @default(now())
}

model AIUsageLog {
  id           String   @id @default(cuid())
  provider     String
  model        String
  taskType     String
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())
}
