generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  passwordHash String?
  googleId     String?       @unique
  image        String?
  authProvider String        @default("credentials")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  // Sender Profile Fields
  businessName String?
  senderName   String?
  senderEmail  String?
  services     String?
  defaultCTA   String?
  calendarLink String?

  leads        Lead[]
  unsubscribes Unsubscribe[]
}

model Lead {
  id                   String      @id @default(cuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName          String
  website              String?
  email                String?
  phone                String?
  location             String?
  industry             String?
  
  // Pitch configuration context
  serviceToPitch       String
  targetNiche          String
  targetLocation       String
  
  // Status: DISCOVERED (pending review), ACCEPTED (accepted in campaign), DECLINED (rejected during discovery)
  status               String      @default("DISCOVERED")
  
  // AI discovery suitability explanation
  suitabilityAnalysis  String?
  
  // Website Audit (outdated design, poor mobile responsiveness, slow loading speed, weak navigation, missing calls to action, broken pages, poor SEO structure, or confusing booking/contact process)
  // Stored as JSON string
  websiteAudit         String?     
  
  // Email outreach fields
  emailSubject         String?
  emailBody            String?
  emailStatus          String      @default("DRAFT") // DRAFT, QUEUED, SENT
  sentAt               DateTime?
  
  // Follow-up tracking
  followUpCount        Int         @default(0)
  lastContactedAt      DateTime?
  nextFollowUpAt       DateTime?
  
  // Pipeline stage
  pipelineStatus       String      @default("NOT_CONTACTED") // NOT_CONTACTED, CONTACTED, REPLIED, INTERESTED, MEETING_BOOKED, WON, LOST, NOT_INTERESTED
  
  replies              LeadReply[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([pipelineStatus])
}

model LeadReply {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body      String
  category  String   // interested, asking_pricing, more_info, not_interested, follow_up_later, auto_reply, unsubscribe
  createdAt DateTime @default(now())

  @@index([leadId])
}

model Unsubscribe {
  id        String   @id @default(cuid())
  email     String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([email])
}
